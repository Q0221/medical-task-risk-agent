# ============================================================
# 生产环境变量模板 — 复制为 .env.prod 后按实际值填写
# 用法：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ============================================================

# ── 应用 ──────────────────────────────────────────────────────
APP_ENV=prod
DEBUG=False

# ── 鉴权（生产必改）──────────────────────────────────────────
AUTH_SECRET_KEY=请替换为随机长字符串
AUTH_DEMO_PASSWORD=请替换为强密码
AUTH_TOKEN_EXPIRE_MINUTES=1440

# ── MySQL（与 docker-compose.prod.yml 中 mysql 服务一致）──────
MYSQL_PASSWORD=请替换为强密码
MYSQL_DB=medical_agent
MYSQL_USER=root
MYSQL_PORT=3306

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 大模型（Agent 对话必填）──────────────────────────────────
LLM_API_KEY=sk-你的百炼Key
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 跨域（先用 IP 可设为 ["*"]，绑域名后改为具体地址）────────
CORS_ORIGINS=["*"]

# ── 首次部署灌演示数据（仅第一次设为 true，之后改回 false）──
RUN_SEED_BULK=true

# ── 对外端口（默认 80）──────────────────────────────────────
WEB_PORT=80

# ── 可选：外部 RAG 服务 ──────────────────────────────────────
RAG_BASE_URL=
RAG_API_KEY=

# ── 可选：通知渠道 ───────────────────────────────────────────
DEFAULT_NOTIFY_CHANNEL=im
WXWORK_WEBHOOK_URL=
WXWORK_MENTION_ALL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# ── 可选：LangSmith 链路追踪 ─────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-task-risk-agent
LANGSMITH_TRACING=false
